PORT=5000
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
NODE_ENV=development

# AWS DynamoDB Database Configuration
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
DYNAMODB_TABLE_PREFIX=mrcargo_

# Platform Super Admin Credentials (Multi-Tenant SaaS Management)
SUPERADMIN_NAME=Platform Super Admin
SUPERADMIN_USERNAME=mrcargo
SUPERADMIN_PASSWORD=your_superadmin_password_here
SUPERADMIN_EMAIL=mrcargo59@gmail.com

# SMTP Email Dispatch Gateway
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mrcargo59@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM_NAME=MrCargo Logistics Platform
SMTP_FROM_EMAIL=mrcargo59@gmail.com
CLIENT_PORTAL_URL=http://localhost:5173/#login
