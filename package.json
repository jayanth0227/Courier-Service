{
  "name": "courier-service",
  "version": "1.0.0",
  "description": "Professional Parcel & Bus Dispatch Management System",
  "main": "server/server.js",
  "scripts": {
    "predev": "node scripts/clean-ports.js",
    "clean-ports": "node scripts/clean-ports.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev:client-only",
    "dev": "node scripts/clean-ports.js && concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "node server/utils/seed.js",
    "test:security": "node --test server/tests/security.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "courier",
    "bus-dispatch",
    "parcel-management",
    "logistics"
  ],
  "author": "Courier Service",
  "license": "ISC"
}
